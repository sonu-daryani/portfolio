# =====================
# AI chatbot (any model)
# =====================
# Provide just a URL + key + model. Works with any OpenAI-compatible API
# (OpenAI, OpenRouter, Groq, Together, Mistral, DeepSeek, vLLM, LM Studio...)
# and with Ollama (local or cloud). The URL can be a base URL or full endpoint.
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     https://ollama.com  (or http://localhost:11434)
AI_API_URL=https://ollama.com
AI_API_KEY=
AI_MODEL=gpt-oss:120b
# Optional: openai | ollama (auto-detected from the URL when blank)
AI_API_FORMAT=

# =====================
# SMTP (contact form)
# =====================
# Used by /api/contact to send the recruiter notification + auto-reply.
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your.email@gmail.com
